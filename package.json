{
  "name": "vue-element-admin",
  "version": "4.4.0",
  "description": "A magical vue admin. An out-of-box UI solution for enterprise applications. Newest development stack of vue. Lots of awesome features",
  "author": "Pan <panfree23@gmail.com>",
  "scripts": {
    "dev": "vue-cli-service serve --port 9529",
    "local": "vue-cli-service serve --mode=local",
    "dev.sh": "vue-cli-service serve --mode sh_dev --port 9527",
    "localhost": "vue-cli-service serve --mode localhost",
    "lint": "eslint --fix --ext .js,.vue src",
    "build": "vue-cli-service build --mode localhost",
    "build:prod": "vue-cli-service build",
    "build:stage": "vue-cli-service build --mode staging",
    "build:v2_stage": "vue-cli-service build --mode v2_staging",
    "build:zoo_stage": "vue-cli-service build --mode zoo_staging",
    "build:sh_stage": "vue-cli-service build --mode sh_staging",
    "preview": "node build/index.js --preview",
    "new": "plop",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml",
    "test:unit": "jest --clearCache && vue-cli-service test:unit",
    "test:ci": "npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@achrinza/node-ipc": "^9.2.6",
